SPRING_PROFILES_ACTIVE=prod
DD_ENV=staging
DD_SERVICE=uno-risk-service
DD_VERSION=v1.2.3
DD_AGENT_HOST = localhost
DD_SITE=datadoghq.com
ECS_FARGATE=true
DD_APM_ENABLED=true
DD_PROFILING_ENABLED=true
DD_APM_NON_LOCAL_TRAFFIC=true
DD_LOGS_ENABLED=true
DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true
DD_LOGS_INJECTION=true
DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true
DD_DOGSTATSD_PORT=8125
DD_PROCESS_AGENT_ENABLED=true
DD_CONTAINER_EXCLUDE=name:dd_agent
DD_REMOTE_UPDATES=true
DD_ECS_TASK_COLLECTION_ENABLED=true
DD_ECS_COLLECT_RESOURCE_TAGS_EC2=true
DD_ECS_COLLECT_TASK_METADATA=true
DD_APM_RECEIVER_SOCKET=/var/run/datadog/apm.socket
DD_CONTAINER_SOCKET_PATH=/var/run/datadog
DD_TRACE_AGENT_SOCKET=/var/run/datadog/apm.socket
DD_LOGS_CONFIG_DOCKER_CONTAINER_FORCE_USE_FILE=true
DD_LOGS_CONFIG_DOCKER_CONTAINER_USE_FILE=true
DD_CONTAINER_COLLECTION_ENABLED=true
DD_ORCHESTRATOR_EXPLORER_ENABLED=true
