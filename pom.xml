    <resource.delimiter>@</resource.delimiter>
    <sonar-maven-plugin.version>4.0.0.4121</sonar-maven-plugin.version>
    <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
    <spring-cloud-dependencies.version>2023.0.3</spring-cloud-dependencies.version>
    <!-- Override Undertow: CVE-2025-12543 (GHSA-j382-5jj3-vw4j); latest 2.3.x. CVE-2026-3260 / GHSA-3x3v-w654-m28m (GET+multipart DoS) has no stable sub-2.4 fix in vendor feeds — see .grype.yaml until 2.3 backport or Spring adopts 2.4+ -->
    <undertow.version>2.3.22.Final</undertow.version>
    <!-- Override Commons IO to fix CVE-2024-47554 (GHSA-78wr-2p64-hpwj) - XmlStreamReader DoS -->
    <commons-io.version>2.14.0</commons-io.version>
    <!-- Override Jackson to fix GHSA-72hv-8253-57qq (async parser DoS), GHSA-j3rv-43j4-c7qm / CVE-2026-54512 (PTV generic type bypass), GHSA-rmj7-2vxq-3g9f / CVE-2026-54513 (allowIfSubTypeIsArray bypass) -->
    <jackson-bom.version>2.21.4</jackson-bom.version>
    <!-- Override Guava to fix CVE-2023-2976, CVE-2018-10237 -->
    <guava.version>33.3.1-jre</guava.version>
    <!-- Override Netty: CVE-2025-67735; CVE-2026-33870 / GHSA-pwqr-wmgm-9rr8; CVE-2026-33871 / GHSA-w9fj-cfpg-grvv; GHSA-mj4r-2hfc-f8p6 (Lz4FrameDecoder); GHSA-57rv-r2g8-2cj3 (HttpClientCodec); GHSA-3qp7-7mw8-wx86 / CVE-2026-44249 (IPv6 IpSubnetFilter bypass); GHSA-x4gw-5cx5-pgmh / CVE-2026-45416 (SNI ClientHello memory DoS); GHSA-mvh2-crg5-v77c / CVE-2026-55833, GHSA-6jqx-86gh-f27w / CVE-2026-55831, GHSA-jppx-w49h-x2qq / CVE-2026-56745 (SPDY/HTTP codec); GHSA-558v-64gr-wgg4 / CVE-2026-59901 (Bzip2Decoder) -->
    <netty.version>4.1.136.Final</netty.version>
    <!-- Override Commons Lang3 to fix CVE-2025-48924 (commons-lang/commons-lang3 uncontrolled recursion) -->
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <!-- Override Logback to fix CVE-2026-1225 (arbitrary class instantiation via config) -->
    <logback.version>1.5.25</logback.version>
    <!-- Spring Security 6.5.10+ fixes GHSA-cvc6-q2cp-2xhw, GHSA-x2wq-9x2f-fhj7, GHSA-vxf7-qj7q-83fh; 6.5.9+ fixes CVE-2026-22732 / GHSA-mf92-479x-3373 -->
    <spring-security.version>6.5.10</spring-security.version>
    <!-- Spring Framework 6.2.19+ fixes CVE-2026-22745/22737, CVE-2026-41853 (multipart smuggling), CVE-2026-41854 (UriComponentsBuilder SSRF), and related spring-web/spring-mvc advisories -->
    <spring-framework.version>6.2.19</spring-framework.version>
    <!-- Thymeleaf 3.1.5+ fixes CVE-2026-40477, CVE-2026-40478, CVE-2026-41901 (SSTI/RCE sandbox bypass) -->
    <thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
    <thymeleaf-extras-springsecurity.version>3.1.5.RELEASE</thymeleaf-extras-springsecurity.version>
    <!-- OpenTelemetry 1.62.0+ fixes CVE-2026-45292 (unbounded W3C baggage propagation) -->
    <opentelemetry.version>1.62.0</opentelemetry.version>
